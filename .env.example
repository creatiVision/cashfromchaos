# CashFromChaos environment

# --- Operator brain selection ---
# hermes  = THE operator (default). Live brain via the local `hermes` CLI: it
#           drafts the listings and negotiates with buyers. Built on the
#           deterministic policy engine, so every decision/price stays inside
#           CommercePolicy; falls back to deterministic text if the CLI fails.
# fixture = deterministic-only opt-out: no CLI, fully offline, reproducible.
# llm     = alias for hermes.
OPERATOR_BRAIN=hermes

# --- Payment provider selection ---
# stripe    = real Stripe test-mode Checkout (requires STRIPE_SECRET_KEY below)
# paypal    = PayPal checkout (mock/test mode; requires PAYPAL_CLIENT_ID +
#             PAYPAL_CLIENT_SECRET, otherwise falls back to simulated)
# simulated = offline demo flow, no network, always available
# If the selected provider is not configured, the app automatically falls
# back to "simulated" so the demo never breaks.
PAYMENT_PROVIDER=stripe

# --- PayPal (test/mock mode) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Stripe (test mode) ---
# Leave blank to run in SIMULATED payment mode (no network, fully demoable).
# Provide a test-mode secret key (sk_test_...) to use real Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL used for Stripe redirect URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Hermes CLI operator (the default operator; skipped only with OPERATOR_BRAIN=fixture) ---
# The app shells out to a Hermes profile in single-shot mode (`<bin> -z ...`).
# DEFAULT BIN = `hackathon` (the isolated profile wrapper), NOT `hermes` — bare
# `hermes` would bill the user's personal `default` profile (OpenAI Codex /
# ChatGPT Plus) and exhaust their personal quota. Configure the hackathon
# profile once with: `hackathon portal` then `hackathon model` (Nemotron).
HERMES_BIN=hackathon
# HERMES_MODEL=...               # leave unset to use the profile's default model
# HERMES_TIMEOUT_MS=60000        # per-call timeout before falling back

# --- Optional API auth (machine-to-machine, e.g. Hermes/AionUI/n8n) ---
# When set, mutating API endpoints (items POST, negotiate, checkout,
# fulfillment, reset) require "Authorization: Bearer <CFC_API_TOKEN>".
# Unset = open access (demo default). The browser UI does NOT send tokens —
# only enable this when external agents use the API.
# CFC_API_TOKEN=
